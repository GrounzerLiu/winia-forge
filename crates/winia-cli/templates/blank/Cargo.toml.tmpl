[package]
name = "__PACKAGE_NAME__"
version = "__VERSION__"
edition = "2024"

[lib]
name = "__LIB_NAME__"
crate-type = ["rlib", "cdylib"]

[[bin]]
name = "__PACKAGE_NAME__"
path = "src/main.rs"

[target.'cfg(target_os = "android")'.dependencies]
# Graphite/wgpu is the only renderer; Android only adds the GameActivity backend.
winia = __WINIA_DEP_ANDROID__
winit = { package = "winia-winit", version = "=0.31.0-beta.4", features = ["android-game-activity"] }

[target.'cfg(not(target_os = "android"))'.dependencies]
winia = __WINIA_DEP_DESKTOP__

[build-dependencies]
winres = "0.1"
