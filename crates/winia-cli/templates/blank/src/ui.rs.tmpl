use winia::prelude::*;

#[composable]
pub fn app(ctx: &mut ComposeCtx) {
    WiniaTheme::auto(ctx, |ctx| {
        Window::new()
            .title(crate::winia_config::APP_NAME)
            .size(1000.0, 700.0)
            .resizable(true)
            .decorations(true)
            .build(ctx, |ctx| {
                Scaffold::new(|ctx, padding| {
                    Column::new()
                        .modifier(
                            Modifier::new()
                                .fill_max_size()
                                .padding_sides(
                                    padding.start,
                                    padding.top,
                                    padding.end,
                                    padding.bottom,
                                )
                                .padding(24.0),
                        )
                        .build(ctx, |ctx| {
                            Text::new("Hello, Winia!").build(ctx);
                        });
                })
                .build(ctx);
            });
    });
}
