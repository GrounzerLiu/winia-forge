use winia::prelude::*;

#[composable]
pub fn app(ctx: &mut ComposeCtx) {
    WiniaTheme::auto(ctx, |ctx| {
        Window::new()
            .title(crate::winia_config::WINDOW_TITLE)
            .size(
                crate::winia_config::WINDOW_WIDTH,
                crate::winia_config::WINDOW_HEIGHT,
            )
            .build(ctx, |ctx| {
                Column::new()
                    .modifier(Modifier::new().fill_max_size().padding(24.0))
                    .build(ctx, |ctx| {
                        Text::new("Hello, Winia!").build(ctx);
                    });
            });
    });
}
